<Window x:Class="BanCaPhe.DangKy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BanCaPhe"
        xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
        mc:Ignorable="d"
        Title="Modtra - Đăng ký"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAFAF8">

    <Window.DataContext>
        <vm:DangKyViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- BÊN TRÁI - LOGO & BRAND -->
        <Border Grid.Column="0" Background="#A8D5BA" Padding="40">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- LOGO & BRAND -->
                <StackPanel Margin="0,0,0,40">
                    <TextBlock Text="🍵" 
                               FontSize="64" 
                               TextAlignment="Center"
                               Margin="0,0,0,16"/>
                    
                    <TextBlock Text="MODTRA" 
                               FontSize="36" 
                               FontWeight="Bold" 
                               Foreground="#FFFFFF" 
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Matcha &amp; Cà phê" 
                               FontSize="16" 
                               Foreground="#FFFFFF" 
                               TextAlignment="Center"
                               Opacity="0.95"
                               Margin="0,0,0,4"/>
                    
                    <TextBlock Text="Chất lượng cao" 
                               FontSize="14" 
                               Foreground="#FFFFFF" 
                               TextAlignment="Center"
                               Opacity="0.85"/>
                </StackPanel>
                
                <!-- TAGLINE -->
                <TextBlock Text="Tạo tài khoản mới ngay!" 
                           FontSize="13" 
                           Foreground="#FFFFFF" 
                           TextAlignment="Center"
                           Opacity="0.9"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- BÊN PHẢI - FORM ĐĂNG KÝ -->
        <Border Grid.Column="1" Background="#FFFFFF" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Padding="60,50,60,50">
                    <StackPanel VerticalAlignment="Center">
                        <!-- TIÊU ĐỀ -->
                        <TextBlock Text="Đăng ký" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   Foreground="#2D5F3F"
                                   Margin="0,0,0,10"/>
                    
                        <TextBlock Text="Tạo tài khoản mới của bạn" 
                                   FontSize="13" 
                                   Foreground="#6B8B7E"
                                   Margin="0,0,0,40"/>

                        <!-- HỌ TÊN -->
                        <TextBlock Text="Họ tên" 
                                   FontSize="12" 
                                   FontWeight="SemiBold"
                                   Foreground="#2D5F3F"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="txtHoTen"
                                 Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}"
                                 Height="46"
                                 Margin="0,0,0,24"
                                 Padding="14,12"
                                 FontSize="13"
                                 Background="#F1F8F4"
                                 Foreground="#2D5F3F"
                                 BorderBrush="#D0E8DC"
                                 BorderThickness="1">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#A8D5BA"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- EMAIL -->
                        <TextBlock Text="Email" 
                                   FontSize="12" 
                                   FontWeight="SemiBold"
                                   Foreground="#2D5F3F"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="txtEmail"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Height="46"
                                 Margin="0,0,0,24"
                                 Padding="14,12"
                                 FontSize="13"
                                 Background="#F1F8F4"
                                 Foreground="#2D5F3F"
                                 BorderBrush="#D0E8DC"
                                 BorderThickness="1">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#A8D5BA"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- SỐ ĐIỆN THOẠI -->
                        <TextBlock Text="Số điện thoại" 
                                   FontSize="12" 
                                   FontWeight="SemiBold"
                                   Foreground="#2D5F3F"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="txtSoDienThoai"
                                 Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}"
                                 Height="46"
                                 Margin="0,0,0,24"
                                 Padding="14,12"
                                 FontSize="13"
                                 Background="#F1F8F4"
                                 Foreground="#2D5F3F"
                                 BorderBrush="#D0E8DC"
                                 BorderThickness="1">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#A8D5BA"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- MẬT KHẨU -->
                        <TextBlock Text="Mật khẩu" 
                                   FontSize="12" 
                                   FontWeight="SemiBold"
                                   Foreground="#2D5F3F"
                                   Margin="0,0,0,8"/>
                        <PasswordBox x:Name="txtMatKhau"
                                     Height="46"
                                     Margin="0,0,0,24"
                                     Padding="14,12"
                                     FontSize="13"
                                     Background="#F1F8F4"
                                     BorderBrush="#D0E8DC"
                                     BorderThickness="1">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#A8D5BA"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <!-- XÁC NHẬN MẬT KHẨU -->
                        <TextBlock Text="Xác nhận mật khẩu" 
                                   FontSize="12" 
                                   FontWeight="SemiBold"
                                   Foreground="#2D5F3F"
                                   Margin="0,0,0,8"/>
                        <PasswordBox x:Name="txtXacNhan"
                                     Height="46"
                                     Margin="0,0,0,32"
                                     Padding="14,12"
                                     FontSize="13"
                                     Background="#F1F8F4"
                                     BorderBrush="#D0E8DC"
                                     BorderThickness="1">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#A8D5BA"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <!-- NÚT ĐĂNG KÝ -->
                        <Button Content="Đăng ký"
                                Height="50"
                                FontSize="15"
                                FontWeight="Bold"
                                Margin="0,0,0,24"
                                Command="{Binding DangKyCommand}"
                                CommandParameter="{Binding ElementName=txtMatKhau}"
                                Background="#2D7A5C"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="8" 
                                                        BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3A9B73"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- LIÊN KẾT ĐĂNG NHẬP -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                            <TextBlock Text="Đã có tài khoản? " 
                                       Foreground="#6B8B7E"
                                       FontSize="12"/>
                            <TextBlock Text="Đăng nhập"
                                       Foreground="#2D7A5C"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Cursor="Hand"
                                       TextDecorations="Underline">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding QuayLaiCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
