<Window x:Class="BanCaPhe.Views.W_LichSuDonHang"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BanCaPhe.Converters"
        Title="Lịch sử đơn hàng" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#FAFAF8">
    
    <Window.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="LỊCH SỬ ĐƠN HÀNG" FontSize="24" FontWeight="Bold" Foreground="#2D5F3F" Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding LichSuDonHang}" 
                  AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" BorderBrush="#D0E8DC" 
                  RowHeight="80" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã ĐH" Binding="{Binding DonHangID}" Width="60"/>
                <DataGridTextColumn Header="Ngày lập" Binding="{Binding NgayLap, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="120"/>
                
                <DataGridTemplateColumn Header="Hình ảnh" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding HinhAnhDoUong, Converter={StaticResource ImagePathConverter}}" 
                                   Width="60" Height="60" Stretch="UniformToFill" Margin="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Đồ uống" Binding="{Binding TenDoUong}" Width="150"/>
                <DataGridTextColumn Header="Size" Binding="{Binding TenKichThuoc}" Width="60"/>
                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="80"/>
                <DataGridTextColumn Header="Topping" Binding="{Binding DanhSachTopping}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Tổng tiền ĐH" Binding="{Binding TongTienDonHang, StringFormat={}{0:N0} đ}" Width="100"/>
                <DataGridTextColumn Header="Nhân viên" Binding="{Binding TenNhanVien}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
