<Window x:Class="BanCaPhe.Views.W_ThanhToanQR"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán qua QR Code" Height="750" Width="1000"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent">
    
    <Border Background="#F0F2F5" CornerRadius="20" BorderBrush="#DDD" BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="QUÉT MÃ ĐỂ THANH TOÁN" 
                           FontSize="26" FontWeight="ExtraBold" 
                           Foreground="#1A1A1A" HorizontalAlignment="Center"/>
                <TextBlock Text="Sử dụng ứng dụng ngân hàng hoặc ví điện tử để quét mã VietQR bên dưới" 
                           FontSize="16" Foreground="#666" 
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- MAIN CONTENT (HORIZONTAL CARD) -->
            <Border Grid.Row="1" Background="White" CornerRadius="25" Padding="40" 
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/> <!-- Increased QR Column -->
                            <ColumnDefinition Width="*"/>   <!-- Details Column -->
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: QR CODE -->
                        <Border Grid.Column="0" Background="White" CornerRadius="20" Padding="20" 
                                BorderBrush="#F0F0F0" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel>
                                <Image Source="{Binding QrCodeImage}" Width="320" Height="320" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="Mã VietQR" FontSize="14" Foreground="#999" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- RIGHT: PAYMENT DETAILS -->
                        <StackPanel Grid.Column="1" Margin="40,0,0,0" VerticalAlignment="Center">
                            
                            <!-- Shop Info -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" Background="#F3E5F5" CornerRadius="12">
                                    <TextBlock Text="🏠" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Cửa hàng" FontSize="13" Foreground="#888"/>
                                    <TextBlock Text="{Binding ShopName}" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                                    <TextBlock Text="{Binding ShopAddress}" FontSize="12" Foreground="#666" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <!-- Bank Info -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" Background="#E3F2FD" CornerRadius="12">
                                    <TextBlock Text="🏦" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ngân hàng" FontSize="13" Foreground="#888"/>
                                    <TextBlock Text="{Binding BankName}" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                                </StackPanel>
                            </Grid>

                            <!-- Account Holder -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" Background="#F1F8E9" CornerRadius="12">
                                    <TextBlock Text="👤" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Chủ tài khoản" FontSize="13" Foreground="#888"/>
                                    <TextBlock Text="{Binding AccountName}" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                                </StackPanel>
                            </Grid>

                            <!-- Account Number -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" Background="#FFF3E0" CornerRadius="12">
                                    <TextBlock Text="💳" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Số tài khoản" FontSize="13" Foreground="#888"/>
                                    <TextBlock Text="{Binding AccountNumber}" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#F0F0F0" Margin="0,5,0,25"/>

                            <!-- Amount & Description -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel>
                                    <TextBlock Text="Số tiền thanh toán" FontSize="13" Foreground="#888"/>
                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:N0} VNĐ}" FontSize="28" FontWeight="ExtraBold" Foreground="#D32F2F" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <TextBlock Text="Nội dung chuyển khoản" FontSize="13" Foreground="#888"/>
                                    <TextBlock Text="{Binding Description}" FontSize="16" FontWeight="SemiBold" Foreground="#444" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- FOOTER BUTTON -->
            <Button Grid.Row="2" Content="ĐÓNG CỬA SỔ" Width="200" Height="50" Margin="0,25,0,0"
                    Background="#2196F3" Foreground="White" FontWeight="Bold" FontSize="16"
                    BorderThickness="0" Click="BtnClose_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="25">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
