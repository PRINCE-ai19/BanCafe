<UserControl x:Class="BanCaPhe.Views.UC_KhachHang"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
             Height="Auto" Width="Auto">
    
    <UserControl.DataContext>
        <vm:UC_KhachHangViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource Admin.BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ TOOLBAR ═══════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource Admin.SurfaceBrush}"
                BorderBrush="{StaticResource Admin.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource HeadlineFont}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Admin.TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,24,0">
                        <Run Text="👥 "/>
                        <Run Text="Quản lý Khách hàng"/>
                    </TextBlock>

                    <!-- SEARCH -->
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="12,0" Width="300" Height="40" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Admin.TextMutedBrush}"/>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource BodyFont}"
                                     FontSize="14"
                                     Foreground="{StaticResource Admin.TextPrimaryBrush}"/>
                        </Grid>
                    </Border>
                    <Button Content="Làm mới" 
                            Style="{StaticResource AdminSecondaryButtonStyle}" 
                            Width="80" 
                            Height="40" 
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>

                <!-- ADD BUTTON -->
                <Button Grid.Column="1" 
                        Content="＋  Thêm khách hàng" 
                        Style="{StaticResource AdminAddButtonStyle}" 
                        Command="{Binding AddCommand}"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════ DATAGRID ═══════════════════════ -->
        <DataGrid x:Name="dgKhachHang"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  ItemsSource="{Binding DanhSachKhachHang}"
                  RowStyle="{StaticResource AdminRowStyle}"
                  CellStyle="{StaticResource AdminCellStyle}"
                  ColumnHeaderStyle="{StaticResource AdminHeaderStyle}"
                  Background="{StaticResource Admin.SurfaceBrush}"
                  RowHeight="64"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  HorizontalScrollBarVisibility="Auto"
                  RowHeaderWidth="0">

            <DataGrid.Columns>

                <!-- ── ID ── -->
                <DataGridTemplateColumn Header="ID" Width="60" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ID}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Admin.TextMutedBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── KHÁCH HÀNG ── -->
                <DataGridTemplateColumn Header="Khách hàng" Width="*" MinWidth="180" SortMemberPath="HoTen">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding HoTen}"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Admin.TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SoDienThoai}"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12" Foreground="{StaticResource Admin.TextMutedBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── NGÀY ĐĂNG KÝ ── -->
                <DataGridTemplateColumn Header="Ngày đăng ký" Width="140" SortMemberPath="NgayDangKy">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NgayDangKy, StringFormat=\{0:dd/MM/yyyy\}}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="13" Foreground="{StaticResource Admin.TextMutedBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- ── MỨC ƯU ĐÃI ── -->
                <DataGridTemplateColumn Header="Mức ưu đãi" Width="120" SortMemberPath="PhanTramGiamGia">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#F0FDF4" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding PhanTramGiamGia, StringFormat=\{0\}%}"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#16A34A"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── TRẠNG THÁI ── -->
                <DataGridTemplateColumn Header="Trạng thái" Width="140" SortMemberPath="ConDung">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Left" CornerRadius="20" Padding="10,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConDung}" Value="False">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#16A34A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConDung}" Value="False">
                                                        <Setter Property="Fill" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontFamily="{StaticResource BodyFont}"
                                               FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Đang hoạt động"/>
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConDung}" Value="False">
                                                        <Setter Property="Text" Value="Ngừng dùng"/>
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── THAO TÁC ── -->
                <DataGridTemplateColumn Header="Thao tác" Width="148" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="✎  Sửa"
                                        Style="{StaticResource AdminEditButtonStyle}"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="✕  Xóa"
                                        Style="{StaticResource AdminDeleteButtonStyle}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
