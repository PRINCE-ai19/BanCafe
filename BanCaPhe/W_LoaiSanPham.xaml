<UserControl x:Class="BanCaPhe.W_LoaiSanPham"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BanCaPhe"
             xmlns:vm="clr-namespace:BanCaPhe.ViewModel">

    <UserControl.DataContext>
        <vm:LoaiSanPhamViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource Admin.BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ TOOLBAR ═══════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource Admin.SurfaceBrush}"
                BorderBrush="{StaticResource Admin.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource HeadlineFont}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Admin.TextPrimaryBrush}">
                        <Run Text="📂 "/>
                        <Run Text="Quản lý Danh mục"/>
                    </TextBlock>
                    <TextBlock Text="{Binding DanhMucList.Count, StringFormat=Tổng cộng {0} danh mục}"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="13" Foreground="{StaticResource Admin.TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="＋  Thêm danh mục"
                        Style="{StaticResource AdminAddButtonStyle}"
                        Command="{Binding ThemCommand}"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════ FORM NHẬP ═══════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource Admin.SurfaceBrush}"
                BorderBrush="{StaticResource Admin.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TÊN LOẠI -->
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Tên danh mục"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Admin.TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="txtTenLoai"
                             Text="{Binding TenLoai, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DefaultTextBoxStyle}"
                             Height="40"/>
                </StackPanel>

                <!-- VỊ TRÍ -->
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Vị trí hiển thị"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Admin.TextMutedBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="txtViTri"
                             Text="{Binding ViTri, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DefaultTextBoxStyle}"
                             Height="40"/>
                </StackPanel>

                <!-- BUTTONS -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="✎  Lưu"
                            Style="{StaticResource AdminAddButtonStyle}"
                            Width="90"
                            Margin="0,0,8,0"
                            Command="{Binding SuaCommand}"/>
                    <Button Content="✕  Xóa"
                            Style="{StaticResource AdminDeleteButtonStyle}"
                            Width="90"
                            Command="{Binding XoaCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════ DATAGRID ═══════════════════════ -->
        <DataGrid x:Name="dgLoaiDoUong"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  ItemsSource="{Binding DanhMucList}"
                  SelectedItem="{Binding SelectedDanhMuc}"
                  RowStyle="{StaticResource AdminRowStyle}"
                  CellStyle="{StaticResource AdminCellStyle}"
                  ColumnHeaderStyle="{StaticResource AdminHeaderStyle}"
                  Background="{StaticResource Admin.SurfaceBrush}"
                  RowHeight="52"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  HorizontalScrollBarVisibility="Auto"
                  RowHeaderWidth="0">

            <DataGrid.Columns>

                <!-- STT (tự tính) -->
                <DataGridTemplateColumn Header="#" Width="60" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ViTri}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Admin.TextMutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- TÊN LOẠI -->
                <DataGridTemplateColumn Header="Tên danh mục" Width="*" SortMemberPath="TenLoai">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TenLoai}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Admin.TextPrimaryBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
