<UserControl x:Class="BanCaPhe.UC_AdminTopping"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
             Height="Auto" Width="Auto">

    <UserControl.DataContext>
        <vm:ToppingViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource Admin.BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ TOOLBAR ═══════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource Admin.SurfaceBrush}"
                BorderBrush="{StaticResource Admin.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource HeadlineFont}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Admin.TextPrimaryBrush}">
                        <Run Text="🍯 "/>
                        <Run Text="Quản lý Topping"/>
                    </TextBlock>
                    <TextBlock Text="{Binding DanhSachTopping.Count, StringFormat=Tổng cộng {0} topping}"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="13" Foreground="{StaticResource Admin.TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="＋  Thêm topping"
                        Style="{StaticResource AdminAddButtonStyle}"
                        Command="{Binding ThemCommand}"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════ DATAGRID ═══════════════════════ -->
        <DataGrid x:Name="dgTopping"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  ItemsSource="{Binding DanhSachTopping}"
                  SelectedItem="{Binding SelectedTopping}"
                  RowStyle="{StaticResource AdminRowStyle}"
                  CellStyle="{StaticResource AdminCellStyle}"
                  ColumnHeaderStyle="{StaticResource AdminHeaderStyle}"
                  Background="{StaticResource Admin.SurfaceBrush}"
                  RowHeight="64"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  HorizontalScrollBarVisibility="Auto"
                  RowHeaderWidth="0">

            <DataGrid.Columns>

                <!-- ── ẢNH ── -->
                <DataGridTemplateColumn Header="Ảnh" Width="80" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="46" Height="46"
                                    CornerRadius="23"
                                    Background="#FFFBEB"
                                    HorizontalAlignment="Center">
                                <Border.Clip>
                                    <EllipseGeometry Center="23,23" RadiusX="23" RadiusY="23"/>
                                </Border.Clip>
                                <Image Source="{Binding HinhAnh}" Stretch="UniformToFill"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── TÊN TOPPING ── -->
                <DataGridTemplateColumn Header="Tên topping" Width="*" MinWidth="140" SortMemberPath="TenTopping">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TenTopping}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Admin.TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── GIÁ ── -->
                <DataGridTemplateColumn Header="Giá" Width="130" SortMemberPath="Gia">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} đ}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Admin.GreenBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── BÁN RIÊNG ── -->
                <DataGridTemplateColumn Header="Bán riêng" Width="120" SortMemberPath="CoTheBanRieng">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Left" CornerRadius="20" Padding="10,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoTheBanRieng}" Value="False">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontFamily="{StaticResource BodyFont}"
                                           FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Có"/>
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoTheBanRieng}" Value="False">
                                                    <Setter Property="Text" Value="Không"/>
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── CÒN BÁN ── -->
                <DataGridTemplateColumn Header="Trạng thái" Width="120" SortMemberPath="ConBan">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Left" CornerRadius="20" Padding="10,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConBan}" Value="False">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontFamily="{StaticResource BodyFont}"
                                           FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Còn bán"/>
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConBan}" Value="False">
                                                    <Setter Property="Text" Value="Ngừng bán"/>
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── THAO TÁC ── -->
                <DataGridTemplateColumn Header="Thao tác" Width="148" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="✎  Sửa"
                                        Style="{StaticResource AdminEditButtonStyle}"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.SuaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="✕  Xóa"
                                        Style="{StaticResource AdminDeleteButtonStyle}"
                                        Command="{Binding DataContext.XoaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
