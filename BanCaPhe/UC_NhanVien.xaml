<UserControl x:Class="BanCaPhe.UC_NhanVien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BanCaPhe.Converters"
             xmlns:vm="clr-namespace:BanCaPhe.ViewModel"
             Height="Auto" Width="Auto">

    <UserControl.DataContext>
        <vm:NhanVienViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource Admin.BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ TOOLBAR ═══════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource Admin.SurfaceBrush}"
                BorderBrush="{StaticResource Admin.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource HeadlineFont}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Admin.TextPrimaryBrush}">
                        <Run Text="👥 "/>
                        <Run Text="Quản lý Nhân viên"/>
                    </TextBlock>
                    <TextBlock Text="{Binding ListNhanVien.Count, StringFormat=Tổng cộng {0} nhân viên}"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="13" Foreground="{StaticResource Admin.TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="＋  Thêm nhân viên"
                        Style="{StaticResource AdminAddButtonStyle}"
                        Command="{Binding ThemCommand}"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════ DATAGRID ═══════════════════════ -->
        <DataGrid x:Name="dgNhanVien"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  ItemsSource="{Binding ListNhanVien}"
                  SelectedItem="{Binding SelectedNhanVien}"
                  RowStyle="{StaticResource AdminRowStyle}"
                  CellStyle="{StaticResource AdminCellStyle}"
                  ColumnHeaderStyle="{StaticResource AdminHeaderStyle}"
                  Background="{StaticResource Admin.SurfaceBrush}"
                  RowHeight="64"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  HorizontalScrollBarVisibility="Auto"
                  RowHeaderWidth="0">

            <DataGrid.Columns>

                <!-- ── ẢNH ── -->
                <DataGridTemplateColumn Header="Ảnh" Width="72" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="44" Height="44"
                                    CornerRadius="22"
                                    Background="#F0FDF4"
                                    HorizontalAlignment="Center">
                                <Border.Clip>
                                    <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/>
                                </Border.Clip>
                                <Image Stretch="UniformToFill"
                                       Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── HỌ TÊN ── -->
                <DataGridTemplateColumn Header="Họ tên" Width="*" MinWidth="140" SortMemberPath="HoTen">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding HoTen}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Admin.TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── EMAIL ── -->
                <DataGridTemplateColumn Header="Email" Width="200" SortMemberPath="Email">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Email}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="13" Foreground="{StaticResource Admin.TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── SĐT ── -->
                <DataGridTemplateColumn Header="Số điện thoại" Width="130" SortMemberPath="SoDienThoai">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SoDienThoai}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="13" Foreground="{StaticResource Admin.TextMutedBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── VAI TRÒ ── -->
                <DataGridTemplateColumn Header="Vai trò" Width="110" SortMemberPath="VaiTro">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Left" CornerRadius="20" Padding="10,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VaiTro}" Value="Admin">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding VaiTro}"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VaiTro}" Value="Admin">
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── TRẠNG THÁI ── -->
                <DataGridTemplateColumn Header="Trạng thái" Width="110" SortMemberPath="TrangThai">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Left" CornerRadius="20" Padding="10,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TrangThai}" Value="False">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontFamily="{StaticResource BodyFont}"
                                           FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Hoạt động"/>
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="False">
                                                    <Setter Property="Text" Value="Tạm nghỉ"/>
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── THAO TÁC ── -->
                <DataGridTemplateColumn Header="Thao tác" Width="208" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="✎  Sửa"
                                        Style="{StaticResource AdminEditButtonStyle}"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.SuaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Button Content="✕  Xóa"
                                        Style="{StaticResource AdminDeleteButtonStyle}"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.XoaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Button Content="🔑 MK"
                                        Style="{StaticResource AdminSecondaryButtonStyle}"
                                        Command="{Binding DataContext.DoiMatKhauCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
