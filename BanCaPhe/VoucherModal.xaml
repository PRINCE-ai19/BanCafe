<Window x:Class="BanCaPhe.VoucherModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Áp dụng mã giảm giá"
        Height="600"
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#E8F0E8"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Search Box -->
            <RowDefinition Height="*"/>    <!-- Customer Info & Results -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D5F3F" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="👤" FontSize="20" Margin="0,0,10,0"/>
                <TextBlock Text="Chọn khách hàng" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Customer Search Box -->
        <Border Grid.Row="1" Background="#FFFFFF" Padding="15" Margin="15,15,15,10" CornerRadius="8" BorderBrush="#D0E8DC" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Tìm kiếm khách hàng" FontSize="12" FontWeight="Bold" Foreground="#2D5F3F" Margin="0,0,0,8"/>
                
                <!-- Search Box with Placeholder -->
                <Grid>
                    <TextBox x:Name="SearchBox" 
                             Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Height="32" 
                             VerticalContentAlignment="Center" 
                             Padding="10,0" 
                             FontSize="11"
                             Background="#F1F8F4" 
                             BorderThickness="1" 
                             BorderBrush="#D0E8DC">
                    </TextBox>
                    
                    <!-- Placeholder Text -->
                    <TextBlock Text="Nhập SĐT hoặc họ tên..." 
                               FontSize="11" 
                               Foreground="#A0A0A0" 
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CustomerSearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CustomerSearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- No Customer Found Message -->
                <TextBlock Text="Không tìm thấy khách hàng" 
                           Visibility="{Binding ShowNoCustomerMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                           FontSize="10" 
                           Foreground="#C62828" 
                           Margin="0,8,0,0" 
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Customer Results & Selected Info -->
        <Border Grid.Row="2" Background="#FFFFFF" Padding="15" Margin="15,0,15,10" CornerRadius="8" BorderBrush="#D0E8DC" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Customer Search Results -->
                    <StackPanel Visibility="{Binding HasCustomerResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Kết quả tìm kiếm" FontSize="12" FontWeight="Bold" Foreground="#2D5F3F" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding CustomerSearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Cursor="Hand" Background="#F1F8F4" Margin="0,0,0,6" CornerRadius="6" BorderBrush="#D0E8DC" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#D0E8DC"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding HoTen}" FontWeight="Bold" FontSize="12" Foreground="#1F4D3D"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="📞 " FontSize="10"/>
                                                    <TextBlock Text="{Binding SoDienThoai}" FontSize="10" Foreground="#4A7C6B" Margin="0,0,15,0"/>
                                                    <TextBlock Text="⭐ " FontSize="10"/>
                                                    <TextBlock Text="{Binding CapBac}" FontSize="10" Foreground="#2D7A5C" FontWeight="Bold" Margin="0,0,15,0"/>
                                                    <TextBlock Text="🎁 " FontSize="10"/>
                                                    <TextBlock Text="{Binding PhanTramGiamGia, StringFormat={}{0}% giảm giá}" FontSize="10" Foreground="#C62828" FontWeight="Bold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Selected Customer Info -->
                    <StackPanel Visibility="{Binding HasSelectedCustomer, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Khách hàng đã chọn" FontSize="12" FontWeight="Bold" Foreground="#2D5F3F" Margin="0,0,0,8"/>
                        <Border Background="#E8F0E8" Padding="15" CornerRadius="8" BorderBrush="#A8D5BA" BorderThickness="2">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedCustomer.HoTen}" FontWeight="Bold" FontSize="14" Foreground="#1F4D3D" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="📞 Số điện thoại: " FontSize="11" Foreground="#4A7C6B" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCustomer.SoDienThoai}" FontSize="11" Foreground="#1F4D3D" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="⭐ Cấp bậc: " FontSize="11" Foreground="#4A7C6B" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCustomer.CapBac}" FontSize="11" Foreground="#2D7A5C" FontWeight="Bold" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="🎁 Giảm giá: " FontSize="11" Foreground="#4A7C6B"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCustomer.PhanTramGiamGia, StringFormat={}{0}%}" FontSize="13" Foreground="#C62828" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="3" Background="#FFFFFF" Padding="15" Margin="15,0,15,15" CornerRadius="8" BorderBrush="#D0E8DC" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="Đóng" 
                        Height="36" 
                        Background="#E0E0E0" 
                        Foreground="#424242" 
                        FontWeight="Bold" 
                        FontSize="11" 
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" 
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#BDBDBD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2" 
                        Content="Áp dụng" 
                        Height="36" 
                        Background="#2D7A5C" 
                        Foreground="#FFFFFF" 
                        FontWeight="Bold" 
                        FontSize="11" 
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ApplyCustomerCommand}"
                        IsEnabled="{Binding HasSelectedCustomer}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="8" 
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3A9B73"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#A0A0A0"/>
                                    <Setter Property="Foreground" Value="#E0E0E0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
