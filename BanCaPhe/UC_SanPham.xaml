<UserControl x:Class="BanCaPhe.UC_SanPham"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BanCaPhe.Converters"
             Height="Auto" Width="Auto">

    <UserControl.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource Admin.BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ TOOLBAR ═══════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource Admin.SurfaceBrush}"
                BorderBrush="{StaticResource Admin.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TITLE -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource HeadlineFont}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Admin.TextPrimaryBrush}">
                        <Run Text="☕ "/>
                        <Run Text="Quản lý Sản phẩm"/>
                    </TextBlock>
                    <TextBlock Text="{Binding SanPhamList.Count, StringFormat=Tổng cộng {0} sản phẩm}"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="13" Foreground="{StaticResource Admin.TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- ADD BUTTON -->
                <Button Grid.Column="1"
                        Content="＋  Thêm sản phẩm"
                        Style="{StaticResource AdminAddButtonStyle}"
                        Command="{Binding ThemCommand}"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════ DATAGRID ═══════════════════════ -->
        <DataGrid x:Name="dgSanPham"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
                  ItemsSource="{Binding SanPhamList}"
                  SelectedItem="{Binding SelectedSanPham}"
                  RowStyle="{StaticResource AdminRowStyle}"
                  CellStyle="{StaticResource AdminCellStyle}"
                  ColumnHeaderStyle="{StaticResource AdminHeaderStyle}"
                  Background="{StaticResource Admin.SurfaceBrush}"
                  RowHeight="68"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  HorizontalScrollBarVisibility="Auto"
                  SelectionMode="Single"
                  RowHeaderWidth="0">

            <DataGrid.Columns>

                <!-- ── HÌNH ẢNH ── -->
                <DataGridTemplateColumn Header="Hình" Width="80" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="48" Height="48" CornerRadius="10"
                                    Background="#F1F5F9"
                                    HorizontalAlignment="Center">
                                <Border.Clip>
                                    <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,48,48"/>
                                </Border.Clip>
                                <Image Stretch="UniformToFill"
                                       Source="{Binding HinhAnh, Converter={StaticResource ImagePathConverter}}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── TÊN SẢN PHẨM ── -->
                <DataGridTemplateColumn Header="Tên sản phẩm" Width="*" MinWidth="160" SortMemberPath="TenDoUong">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TenDoUong}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Admin.TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── GIÁ ── -->
                <DataGridTemplateColumn Header="Giá bán" Width="130" SortMemberPath="Gia">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Gia, StringFormat={}{0:N0} đ}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Admin.GreenBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── DANH MỤC ── -->
                <DataGridTemplateColumn Header="Danh mục" Width="150" SortMemberPath="TenLoai">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#EFF6FF" CornerRadius="20"
                                    Padding="10,4" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding TenLoai}"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12" Foreground="#1D4ED8"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── TRẠNG THÁI ── -->
                <DataGridTemplateColumn Header="Trạng thái" Width="120" SortMemberPath="ConBan">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Left" CornerRadius="20" Padding="10,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConBan}" Value="False">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontFamily="{StaticResource BodyFont}"
                                           FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Còn bán"/>
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConBan}" Value="False">
                                                    <Setter Property="Text" Value="Ngừng bán"/>
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── THAO TÁC ── -->
                <DataGridTemplateColumn Header="Thao tác" Width="148" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="✎  Sửa"
                                        Style="{StaticResource AdminEditButtonStyle}"
                                        Margin="0,0,6,0"
                                        Command="{Binding DataContext.SuaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Button Content="✕  Xóa"
                                        Style="{StaticResource AdminDeleteButtonStyle}"
                                        Command="{Binding DataContext.XoaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
